// Tinker: the standard Scrapling and the reference for every speed in the design doc.
// Speeds in u/s, accelerations in u/s^2, rates per second, angles in radians.
// Design doc: top speed 95% of laser, damage 1x, hull 100, 2 secondary types.
// Schema: `ls_sim::ShipTuning`. Changing a number changes the sim replay golden hash.
ShipTuning(
    radius: 0.5,
    // Per-axis caps in ship space: 12 cruise, 16.5 boost (28.58 u/s on the 3-axis diagonal).
    cruise_speed: 12.0,
    boost_speed: 16.5,
    thrust_accel: 30.0,
    brake_accel: 40.0,
    damping_decel: 8.0,
    overspeed_decel: 20.0,
    restitution: 0.2,
    max_turn_rate: 12.0,
    roll_rate: 2.5,
    horizon_gain: 1.5,
    horizon_max_rate: 0.8,

    hull_max: 100.0,
    energy_max: 100.0,
    boost_max: 100.0,
    scrap_max: 100.0,
    spawn_energy: 100.0,
    spawn_boost: 50.0,
    spawn_scrap: 20.0,
    energy_regen: 10.0,
    boost_drain: 20.0,
    brake_refill_per_speed: 0.6,
    hard_brake_min_speed: 6.0,
    scrape_distance: 0.6,
    scrape_min_speed: 8.0,
    scrape_refill: 30.0,
    scavenge_radius: 3.0,
    scavenge_rate: 20.0,
    hull_per_scrap: 1.0,
    // Overdrive gamble: 2 hull per missing energy point.
    overdrive_hull_per_energy: 2.0,
    damage_mult: 1.0,
    secondary_slots: 2,
    wreck_scrap: 30.0,
    // Support: passing scrap to teammates (Tug only).
    can_pass_scrap: false,
    scrap_pass_rate: 0.0,
    // Paint Thrower colours (M2 plan): restitution against red (bouncy) paint, and the share
    // of the speed caps kept while touching yellow (sticky) paint. Blue (slippery) paint
    // needs no number: no damping while touching it, and wall hits keep the speed.
    paint_bounce_restitution: 0.9,
    paint_sticky_speed: 0.4,
)
