// Echo Cannon: special primary. Projectile returns along the same path after 2 s, so it can
// hit twice. Malus: the returning shot can hit you. Lasting effect: scorch trail along the
// out-and-back path.
// Behaviour: crates/ls-sim/src/weapons/specials/echo_cannon.rs (TODO(wave-B): generic fallback until implemented).
// `params` are read by the weapon module (`WeaponDef::param`); numbers are tuning starting points.
WeaponDef(
    id: "echo_cannon",
    name: "Echo Cannon",
    family: Special,
    slot: Primary,
    speed: 30.0,
    lifetime_secs: 4.0,
    damage: 12.0,
    fire_interval_secs: 0.8,
    cost: Energy(8.0),
    projectile_radius: 0.2,
    knockback: 1.5,
    shield: Wears(1.0),
    visual: (shape: Orb, color: (180, 140, 255), scale: 1.2),
    params: { "return_after_secs": 2.0 },
)
