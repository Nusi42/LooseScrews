// Hauler: heavy hull. Design doc: top speed 85% of laser, damage 1.2x, hull 150, 3 secondary
// types; holds tunnels and soaks damage, largest hitbox.
// Speeds in u/s, accelerations in u/s^2, rates per second, angles in radians.
// Schema: `ls_sim::ShipTuning`. Changing a number changes the sim replay golden hash.
ShipTuning(
    radius: 0.65,
    // Per-axis caps in ship space: 10.72 cruise, 14.72 boost (25.50 u/s = 85% of laser on the diagonal).
    cruise_speed: 10.72,
    boost_speed: 14.72,
    thrust_accel: 24.0,
    brake_accel: 32.0,
    damping_decel: 8.0,
    overspeed_decel: 20.0,
    restitution: 0.2,
    max_turn_rate: 9.5,
    roll_rate: 2.0,
    horizon_gain: 1.5,
    horizon_max_rate: 0.8,

    hull_max: 150.0,
    energy_max: 100.0,
    boost_max: 100.0,
    scrap_max: 100.0,
    spawn_energy: 100.0,
    spawn_boost: 50.0,
    spawn_scrap: 20.0,
    energy_regen: 10.0,
    boost_drain: 20.0,
    brake_refill_per_speed: 0.6,
    hard_brake_min_speed: 6.0,
    scrape_distance: 0.6,
    scrape_min_speed: 8.0,
    scrape_refill: 30.0,
    scavenge_radius: 3.0,
    scavenge_rate: 20.0,
    hull_per_scrap: 1.0,
    // Overdrive gamble: 2 hull per missing energy point.
    overdrive_hull_per_energy: 2.0,
    damage_mult: 1.2,
    secondary_slots: 3,
    wreck_scrap: 45.0,
    // Support: passing scrap to teammates (Tug only).
    can_pass_scrap: false,
    scrap_pass_rate: 0.0,
    // Paint Thrower colours (M2 plan): restitution against red (bouncy) paint, and the share
    // of the speed caps kept while touching yellow (sticky) paint. Blue (slippery) paint
    // needs no number: no damping while touching it, and wall hits keep the speed.
    paint_bounce_restitution: 0.9,
    paint_sticky_speed: 0.4,
)
