// Bolt Rocket: dumbfire ordnance secondary, limited count.
// Design doc: "Dumbfire, 40 u/s. Malus: small blast. Lasting effect: 2 u crater" (diameter -> radius 1.0).
// M2 plan: 30 direct damage plus splash.
// Behaviour: crates/ls-sim/src/weapons/ordnance/bolt_rocket.rs (implemented: the generic hooks are the M1 behaviour).
WeaponDef(
    id: "bolt_rocket",
    name: "Bolt Rocket",
    family: Ordnance,
    slot: Secondary,
    speed: 40.0,
    lifetime_secs: 4.0,
    damage: 30.0,
    fire_interval_secs: 0.75,
    cost: Count(1),
    projectile_radius: 0.2,
    splash: Some((radius: 2.5, damage: 20.0, hits_owner: true)),
    knockback: 8.0,
    terrain: (crater_radius: 1.0, paint_radius: 0.0),
    shield: Wears(1.0),
    max_ammo: 10,
    // Gravity wells bend it in flight (M4).
    gravity: true,
    visual: (shape: Rocket, color: (255, 140, 60), scale: 1.0),
)
