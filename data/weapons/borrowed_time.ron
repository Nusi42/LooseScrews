// Borrowed Time: special secondary. Rewinds your position, velocity and hull by 3 s. Malus:
// weapons offline for 3 s; a ghost stays visible at the old spot for 3 s. Lasting effect:
// terrain damage is not rewound, so the scars stay.
// Behaviour: crates/ls-sim/src/weapons/specials/borrowed_time.rs (implemented). No real shot:
// rewinds position, velocity and hull by `rewind_secs` (the world keeps 3 s of history), weapons
// offline for `offline_secs`, a ghost at the old spot for `ghost_secs`; terrain is not rewound.
// `speed`/`lifetime_secs` only shape the harmless, motionless time pulse left at the old spot.
// Numbers are tuning starting points.
WeaponDef(
    id: "borrowed_time",
    name: "Borrowed Time",
    family: Special,
    slot: Secondary,
    speed: 10.0,
    lifetime_secs: 0.5,
    damage: 0.0,
    fire_interval_secs: 3.0,
    cost: Count(1),
    projectile_radius: 0.2,
    shield: Blocked,
    max_ammo: 2,
    visual: (shape: Orb, color: (120, 200, 255), scale: 0.8),
    params: { "rewind_secs": 3.0, "offline_secs": 3.0, "ghost_secs": 3.0 },
)
