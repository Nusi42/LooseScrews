// Scatter Laser: energy primary. 3 bolts in an alternating fan. Malus: damage spreads thin at
// range. Lasting effect: fan-shaped scorch pattern.
// Behaviour: crates/ls-sim/src/weapons/energy/scatter_laser.rs (TODO(wave-B): generic fallback until implemented).
// `params` are read by the weapon module (`WeaponDef::param`); numbers are tuning starting points.
WeaponDef(
    id: "scatter_laser",
    name: "Scatter Laser",
    family: Energy,
    slot: Primary,
    speed: 30.0,
    lifetime_secs: 3.0,
    damage: 4.0,
    fire_interval_secs: 0.3,
    cost: Energy(4.5),
    projectile_radius: 0.15,
    knockback: 0.5,
    shield: Wears(1.0),
    projectiles: 3,
    spread_deg: 8.0,
    visual: (shape: Bolt, color: (255, 150, 60), scale: 0.9),
    params: { "fan_alternate": 1.0 },
)
