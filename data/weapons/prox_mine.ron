// Prox Mine: ordnance secondary. Dropped behind you, arms after 1 s. Malus: hurts you and
// teammates. Lasting effect: sticks to walls; 3 u crater.
// Behaviour: crates/ls-sim/src/weapons/ordnance/prox_mine.rs (TODO(wave-B): generic fallback until implemented).
// `params` are read by the weapon module (`WeaponDef::param`); numbers are tuning starting points.
WeaponDef(
    id: "prox_mine",
    name: "Prox Mine",
    family: Ordnance,
    slot: Secondary,
    speed: 5.0,
    lifetime_secs: 60.0,
    damage: 40.0,
    fire_interval_secs: 0.5,
    cost: Count(1),
    projectile_radius: 0.3,
    splash: Some((radius: 4.0, damage: 30.0, hits_owner: true)),
    knockback: 8.0,
    terrain: (crater_radius: 1.5),
    shield: Wears(1.0),
    max_ammo: 5,
    visual: (shape: Mine, color: (255, 80, 80), scale: 1.0),
    params: { "arm_secs": 1.0, "trigger_radius": 4.0, "drop_behind": 1.0 },
)
