// Swap Harpoon: special secondary. On hit, you swap positions with the target (velocities swap
// too). Malus: 4 s cooldown; you inherit their momentum. Lasting effect: the harpoon spike
// stays in the wall as a small grab point.
// Behaviour: crates/ls-sim/src/weapons/specials/swap_harpoon.rs (implemented).
// `fire_interval_secs` is the 4 s cooldown. A wall hit leaves a spike (`spike_radius` u) that
// stays until its rock is blasted away; each pilot keeps at most `max_spikes`. A ship within
// `grab_reach` u of a spike holding Scavenge loses `grab_hold` of its velocity per tick.
// Numbers are tuning starting points.
WeaponDef(
    id: "swap_harpoon",
    name: "Swap Harpoon",
    family: Special,
    slot: Secondary,
    speed: 60.0,
    lifetime_secs: 1.5,
    damage: 5.0,
    fire_interval_secs: 4.0,
    cost: Count(1),
    projectile_radius: 0.15,
    knockback: 0.0,
    shield: PassThrough(1.0),
    max_ammo: 5,
    visual: (shape: Harpoon, color: (200, 200, 200), scale: 1.2),
    params: { "spike_radius": 0.3, "max_spikes": 6.0, "grab_reach": 1.0, "grab_hold": 0.25 },
)
