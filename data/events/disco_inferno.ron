// Disco inferno: For 20 s the sun and ambient light drop to 8 %, a disco ball descends over the
// players' centroid, every ship leaves a light trail. No other sim rule.
// Behaviour: crates/ls-sim/src/events/disco_inferno.rs (B3). Schema: `ls_sim::events::EventDef`.
EventDef(
    id: "disco_inferno",
    name: "Disco inferno",
    enabled: true,
    weight: 1.0,
    active_secs: 20.0,
    moods: [Giddy],
    params: {
        // Sun and ambient light while it runs (client).
        "light_level": 0.08,
        // The mirror ball: radius, height over the centroid (closer under a ceiling), how far
        // above that it starts, how long it takes to come down, how fast it follows the
        // centroid (u/s) and its spin (rad/s).
        "ball_radius": 1.5,
        "hang": 10.0,
        "drop": 15.0,
        "descend_secs": 3.0,
        "follow_speed": 3.0,
        "spin": 1.2,
    },
)
