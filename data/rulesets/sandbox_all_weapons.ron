// Sandbox: every weapon and gadget as a pickup, every ship type allowed. For testing the whole
// arsenal (e2e with bots: `node tools/e2e.mjs --ruleset data/rulesets/sandbox_all_weapons.ron`)
// and for playing with everything. Short respawns and even weights, so a 5 minute match sees
// every weapon spawn; the Tectonic Charge stays 1 per map.
// Schema: `ls_sim::RuleSet` (rule set v2).
RuleSet(
    name: "Sandbox - all weapons",
    mode: PaintTheVoid((
        teams: 2,
        match_secs: 300.0,
        respawn_secs: 3.0,
    )),
    weapons: {
        "scrap_laser": LoadoutAndPickup,
        "scatter_laser": PickupOnly,
        "plasma_repeater": PickupOnly,
        "fusion_charger": PickupOnly,
        "corkscrew": PickupOnly,
        "ricochet_arc": PickupOnly,
        "leech_arc": PickupOnly,
        "rivet_gun": PickupOnly,
        "railspike": PickupOnly,
        "scrap_shotgun": PickupOnly,
        "bolt_rocket": LoadoutAndPickup,
        "seeker": PickupOnly,
        "quicksilver": PickupOnly,
        "eyeball": PickupOnly,
        "swarm_pod": PickupOnly,
        "heavy_rocket": PickupOnly,
        "flash_pod": PickupOnly,
        "prox_mine": PickupOnly,
        "stalker_mine": PickupOnly,
        "tectonic_charge": PickupOnly,
        "echo_cannon": PickupOnly,
        "swap_harpoon": PickupOnly,
        "paint_thrower": LoadoutAndPickup,
        "borrowed_time": PickupOnly,
        "magnet_sneeze": PickupOnly,
        "polite_laser": PickupOnly,
        "seed_grenade": PickupOnly,
        "paperweight": PickupOnly,
    },
    gadgets: {
        "shield": LoadoutAndPickup,
        "cloak": PickupOnly,
        "decoy": PickupOnly,
    },
    starting_loadout: (
        primaries: ["scrap_laser", "paint_thrower"],
        secondaries: [("bolt_rocket", 3)],
        gadget: Some("shield"),
    ),
    pickups: {
        "scrap_laser": (weight: 1.0, respawn_secs: 15.0),
        "scatter_laser": (weight: 1.0, respawn_secs: 15.0),
        "plasma_repeater": (weight: 1.0, respawn_secs: 15.0),
        "fusion_charger": (weight: 1.0, respawn_secs: 15.0),
        "corkscrew": (weight: 1.0, respawn_secs: 15.0),
        "ricochet_arc": (weight: 1.0, respawn_secs: 15.0),
        "leech_arc": (weight: 1.0, respawn_secs: 15.0),
        "rivet_gun": (weight: 1.0, respawn_secs: 15.0),
        "railspike": (weight: 1.0, respawn_secs: 15.0),
        "scrap_shotgun": (weight: 1.0, respawn_secs: 15.0),
        "bolt_rocket": (weight: 1.0, respawn_secs: 15.0, ammo: 3),
        "seeker": (weight: 1.0, respawn_secs: 15.0, ammo: 2),
        "quicksilver": (weight: 1.0, respawn_secs: 15.0, ammo: 3),
        "eyeball": (weight: 1.0, respawn_secs: 15.0, ammo: 1),
        "swarm_pod": (weight: 1.0, respawn_secs: 15.0, ammo: 2),
        "heavy_rocket": (weight: 1.0, respawn_secs: 15.0, ammo: 1),
        "flash_pod": (weight: 1.0, respawn_secs: 15.0, ammo: 2),
        "prox_mine": (weight: 1.0, respawn_secs: 15.0, ammo: 3),
        "stalker_mine": (weight: 1.0, respawn_secs: 15.0, ammo: 2),
        "tectonic_charge": (weight: 1.0, respawn_secs: 60.0, ammo: 1, max_on_map: 1),
        "echo_cannon": (weight: 1.0, respawn_secs: 15.0),
        "swap_harpoon": (weight: 1.0, respawn_secs: 15.0, ammo: 2),
        "paint_thrower": (weight: 1.0, respawn_secs: 15.0),
        "borrowed_time": (weight: 1.0, respawn_secs: 15.0, ammo: 1),
        "magnet_sneeze": (weight: 1.0, respawn_secs: 15.0, ammo: 2),
        "polite_laser": (weight: 1.0, respawn_secs: 15.0),
        "seed_grenade": (weight: 1.0, respawn_secs: 15.0, ammo: 2),
        "paperweight": (weight: 1.0, respawn_secs: 15.0, ammo: 3),
    },
    upgrade_pickups: {
        "scrap_laser": (weight: 1.0, respawn_secs: 15.0),
    },
    gadget_pickups: {
        "shield": (weight: 1.0, respawn_secs: 15.0),
        "cloak": (weight: 1.0, respawn_secs: 15.0),
        "decoy": (weight: 1.0, respawn_secs: 15.0),
    },
    scrap_pickup: Some((weight: 6.0, respawn_secs: 15.0, amount: 30.0)),
    // Pigment pickups on monochrome levels (Palette 80+): one per 4 players, at least 2.
    pigment_pickup: Some((respawn_secs: 30, players_per_pickup: 4, min_on_map: 2)),
    shield_overrides: {},
    tuning: {},
    friendly_fire_percent: 50,
    allowed_ship_types: [Skitter, Tinker, Hauler, Tug],
    // Comedy events: the director runs at min(world Absurdity slider, this cap): the world decides.
    absurdity: 100,
)
