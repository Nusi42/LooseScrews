// Paint Thrower: special. Deals no damage; paints terrain in the shooter's team color
// (the core tool of Paint the Void). Surface effects of paint colors come in a later milestone.
// Behaviour: crates/ls-sim/src/weapons/specials/paint_thrower.rs (implemented: the generic hooks are the M1 behaviour).
WeaponDef(
    id: "paint_thrower",
    name: "Paint Thrower",
    family: Special,
    slot: Primary,
    speed: 20.0,
    lifetime_secs: 1.5,
    damage: 0.0,
    fire_interval_secs: 0.1,
    cost: Energy(1.5),
    projectile_radius: 0.3,
    splash: None,
    knockback: 0.0,
    terrain: (crater_radius: 0.0, paint_radius: 2.0),
    shield: Blocked,
    visual: (shape: Paint, color: (255, 255, 255), scale: 1.0),
)
