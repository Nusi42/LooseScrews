// Heavy Rocket: ordnance secondary. 20 u/s, 8 u blast. Malus: very slow; hurts you at close
// range. Lasting effect: 6 u crater that can open a passage between tunnels.
// Behaviour: crates/ls-sim/src/weapons/ordnance/heavy_rocket.rs (implemented: the generic
// dumbfire rocket driven by these numbers).
// Damage 70 direct (M2 damage scale); the 8 u splash also hits the shooter (the close-range
// malus); crater radius 3 u = the design doc's 6 u diameter, enough to break through about
// 2.5 u of ordinary rock.
WeaponDef(
    id: "heavy_rocket",
    name: "Heavy Rocket",
    family: Ordnance,
    slot: Secondary,
    speed: 20.0,
    lifetime_secs: 6.0,
    damage: 70.0,
    fire_interval_secs: 1.5,
    cost: Count(1),
    projectile_radius: 0.35,
    splash: Some((radius: 8.0, damage: 50.0, hits_owner: true)),
    knockback: 15.0,
    terrain: (crater_radius: 3.0),
    shield: Wears(1.0),
    max_ammo: 3,
    visual: (shape: Rocket, color: (255, 60, 30), scale: 1.8),
)
