// Gravity wells (M4, Gravity Chaos slider; docs/milestone-4-plan.md §3.3, §3.8 "Wells").
// Schema: `ls_sim::gravity::GravitySettings`. Accelerations in u/s^2, lengths in u.
// Force law of every well: a = G r / (r^2 + s^2)^1.5, tapered by (1 - r^2/R^2)^2 to zero at its
// range R; G is chosen so the untapered law peaks at `peak_accel` (at r = s / sqrt 2).
// Changing a number changes the data hash (handshake).
GravitySettings(
    // Peak pull of a static well (generator site, shepherd moon) at Gravity Chaos 1 and 100.
    // 12 = 40 % of the Tinker's per-axis thrust acceleration (30).
    peak_accel: (4.0, 12.0),
    // Range of a static well at Gravity Chaos 1 and 100.
    range: (20.0, 40.0),
    // Softening length s: the pull peaks 2.1 u from the centre (at the core stone's surface).
    softening: 3.0,
    // The total pull on a ship is clamped to this share of its per-axis thrust acceleration,
    // so stacked wells never trap a ship.
    ship_clamp: 0.4,
    // The total pull on debris and `gravity: true` projectiles is clamped to this.
    body_clamp: 12.0,
    // Resting debris wakes up when pulled harder than this.
    wake_accel: 0.5,
    // On a ship axis without input the dampers aim at the drift speed pull * drift_secs (at
    // most the cruise cap) instead of standing still: idle and coasting ships fall toward a
    // well (12 u/s next to a strong core, about 1 u/s at the edge of its range).
    drift_secs: 1.0,
)
