{
  "name": "loose-screws-web",
  "private": true,
  "version": "0.4.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "prepare": "node ../tools/hooks/install.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "node ../tools/work-folders.mjs guard \"npm run dev\" && node scripts/build-wasm.mjs && vite",
    "build": "npm run build:wasm && npm run typecheck && vite build",
    "typecheck": "node scripts/build-wasm.mjs --if-missing && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@webgpu/types": "0.1.74",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
