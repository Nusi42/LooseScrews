// Leech Arc: energy primary. Short arc (12 u) that locks the nearest target and drains its
// energy into yours. Malus: useless beyond 12 u. Lasting effect: surfaces stay charged for 15
// s and drain energy from ships that scrape them. The only instant weapon (M2 plan): no
// projectile; `speed` and `lifetime_secs` only describe the arc's reach for tools that read them.
// Behaviour: crates/ls-sim/src/weapons/energy/leech_arc.rs.
// `params` are read by the weapon module (`WeaponDef::param`); numbers are tuning starting points.
WeaponDef(
    id: "leech_arc",
    name: "Leech Arc",
    family: Energy,
    slot: Primary,
    speed: 90.0,
    lifetime_secs: 0.134,
    // 10 arcs/s: 20 damage/s (a Tinker in 5 s) and 20 energy/s drained into the shooter.
    damage: 2.0,
    fire_interval_secs: 0.1,
    cost: Energy(0.5),
    projectile_radius: 0.2,
    knockback: 0.2,
    shield: PassThrough(0.5),
    visual: (shape: Arc, color: (120, 255, 255), scale: 1.0),
    params: {
        // Lock: nearest enemy within `range` u inside a cone of `lock_half_angle_deg` around
        // the aim, with line of sight.
        "range": 12.0,
        "lock_half_angle_deg": 30.0,
        // The lock persists while the target stays in range with line of sight and inside this
        // wider cone, even if another enemy comes closer.
        "lock_keep_half_angle_deg": 60.0,
        // Energy moved from the target to the shooter per arc (20/s at 10 arcs/s).
        "drain_per_arc": 2.0,
        // A beam cue every `beam_every`-th arc (value: the ticks it covers), not one per arc.
        "beam_every": 3.0,
        // The arc grounds `ground_reach` u past a locked target (or along the aim up to `range`
        // without one); rock it touches stays charged for `charged_secs` within `charged_radius` u.
        "ground_reach": 3.0,
        "charged_radius": 1.0,
        "charged_secs": 15.0,
        // Read by the framework: energy/s drained from ships scraping charged rock (M2 plan: 5).
        "charged_drain_per_sec": 5.0,
    },
)
