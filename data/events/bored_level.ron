// Bored level: The level's "up" turns 90 degrees about a seeded horizontal axis over 5 s and
// stays turned (`World::up`; terrain keeps its coordinates).
// Behaviour: crates/ls-sim/src/events/bored_level.rs (B1). Schema: `ls_sim::events::EventDef`.
EventDef(
    id: "bored_level",
    name: "Bored level",
    enabled: true,
    weight: 1.0,
    // The turn takes turn_secs (eased); the active phase holds the turned up a
    // second longer so the final up is replicated before the event ends.
    active_secs: 6.0,
    moods: [Bored],
    params: { "turn_degrees": 90.0, "turn_secs": 5.0 },
)
